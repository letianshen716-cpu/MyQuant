# ==============================
# 1. 数据与实验产出 (核心保护区)
# ==============================
# 忽略整个 data 文件夹及其下面的所有内容
data/

# 如果你在别处生成了这些数据文件，也全局忽略
*.csv
*.xlsx
*.pkl
*.parquet
*.h5

# ==============================
# 2. Python 运行缓存与配置文件
# ==============================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==============================
# 3. 虚拟环境 (防止把环境包也传上去)
# ==============================
venv/
env/
.env

# ==============================
# 4. 操作系统生成的垃圾文件
# ==============================
# Mac 系统隐藏文件
.DS_Store
# Windows 系统缩略图缓存
Thumbs.db