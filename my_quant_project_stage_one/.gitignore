# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
env/
venv/
ENV/
.env

# 数据存储（量化大文件与原始特征严禁提交到 Git）
data/raw_data/*
data/processed_data/*
!data/raw_data/.gitkeep
!data/processed_data/.gitkeep

# 自动生成的报告与日志
docs/reports/*.md
docs/reports/*.pdf
docs/reports/*.png
*.log

# Jupyter Notebook 缓存
.ipynb_checkpoints

# 编辑器与 IDE 配置
.vscode/
.idea/
*.swp
*.swo
.DS_Store