# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
env/
venv/
ENV/
.env

# 数据存储（量化大文件严禁提交到 Git）
data/raw/*
data/processed/*.parquet
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Jupyter Notebook 缓存
.ipynb_checkpoints

# 编辑器与 IDE 配置
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# 运行日志
*.log